{
  "author": "",
  "build": {
    "appId": "com.flow.dictation",
    "asar": true,
    "asarUnpack": [
      "swift/flow-fn-listener",
      "swift/flow-fullscreen-check"
    ],
    "directories": {
      "output": "release/"
    },
    "files": [
      "dist/**/*",
      "index.html",
      "onboarding.html",
      "package.json",
      "styles/**/*",
      "swift/flow-fn-listener",
      "swift/flow-fullscreen-check"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Flow records short voice notes for dictation when you hold the hotkey."
      },
      "hardenedRuntime": false,
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-"
    }
  },
  "description": "Flow — lean open-source push-to-talk dictation for macOS (fn to talk, Gateway STT, paste at cursor).",
  "devDependencies": {
    "@types/node": "^22.7.0",
    "electron": "^41.2.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.6.3",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "main": "dist/src/main.js",
  "name": "flow",
  "private": false,
  "scripts": {
    "build": "tsc && node scripts/strip-cjs-prelude.js",
    "check": "tsc --noEmit",
    "dev": "node scripts/dev.js",
    "package": "npm run build && electron-builder build --mac -c.mac.identity=- --publish never",
    "start": "npm run build && electron .",
    "test": "vitest run"
  },
  "version": "0.2.5",
  "packageManager": "pnpm@11.25.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dancaldera/flow.git"
  }
}
